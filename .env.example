# Copy this to .env and fill in real values. NEVER commit .env to git.

# ── Application ───────────────────────────────────────────────────────────
APP_NAME="AI Gateway"
DEBUG=false

# ── Security ─────────────────────────────────────────────────────────────
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── ChromaDB ─────────────────────────────────────────────────────────────
# Set false on Python 3.14 + Windows (ChromaDB query segfaults). Enable on Mac/Linux.
ENABLE_SEMANTIC_CACHE=false
CHROMA_HOST=localhost
CHROMA_PORT=8002
CHROMA_COLLECTION=prompt_cache
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL_HOURS=24

# ── LLM Providers ────────────────────────────────────────────────────────
# Cerebras public tier: gpt-oss-120b (production), gemma-4-31b (preview cheap)
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

PRIMARY_MODEL=gpt-oss-120b
FALLBACK_MODEL=gpt-oss-120b

# ── Smart Routing + Compression (Phase 1/2) ───────────────────────────────
ENABLE_SMART_ROUTING=false
ENABLE_PROMPT_COMPRESSION=false
COMPRESSION_THRESHOLD_TOKENS=1500
CHEAP_MODEL=gemma-4-31b
PREMIUM_MODEL=gpt-oss-120b

# ── Rate Limits (tokens per minute) ───────────────────────────────────────
RATE_LIMIT_FREE=10000
RATE_LIMIT_PRO=100000
RATE_LIMIT_ENTERPRISE=1000000
